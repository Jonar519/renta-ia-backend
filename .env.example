# Copia este archivo como ".env" y ajusta los valores.
# En Windows (cmd.exe): copy .env.example .env

# --- Base de datos (debe coincidir con lo que usaste en renta-ia-database) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/renta_ia

# --- Autenticación ---
JWT_SECRET=cambia_este_valor_por_uno_seguro_y_largo
# Access token de corta vida (el navegador lo guarda solo en memoria).
JWT_EXPIRES_IN=15m
# Vida del refresh token (cookie httpOnly rotativa), en días.
REFRESH_TOKEN_TTL_DAYS=7
# Cookie "Secure" (solo HTTPS). Por defecto true en producción y false en local.
# COOKIE_SECURE=false

# --- Servidor ---
PORT=4000
NODE_ENV=development
# Nivel de logs de pino: fatal | error | warn | info | debug (en tests: silent)
LOG_LEVEL=info

# --- Seguridad HTTP ---
# Orígenes permitidos por CORS, separados por coma. OBLIGATORIO en producción.
CORS_ORIGIN=http://localhost:5173
# Número de proxies delante de la API (0 en local, 1 detrás de un balanceador).
TRUST_PROXY=0

# --- Cola de tareas (Redis, ver docker-compose.yml de este repo) ---
REDIS_URL=redis://localhost:6379
# Documentos que el worker procesa en paralelo (ver docs/load-test-report.md).
WORKER_CONCURRENCY=2

# --- Operación ---
# Token para leer GET /metrics (API) y :WORKER_METRICS_PORT/metrics (worker)
# con "Authorization: Bearer <token>". Vacío = métricas desactivadas (404).
METRICS_TOKEN=
WORKER_METRICS_PORT=9464
# Tiempo máximo del apagado ordenado (SIGTERM / Ctrl+C) antes de forzar la salida.
SHUTDOWN_TIMEOUT_MS=10000
# Espera entre "/ready responde 503" y cerrar el servidor (para el balanceador).
# 0 en local; en producción, al menos el intervalo del health check (debe ser
# menor que SHUTDOWN_TIMEOUT_MS).
SHUTDOWN_DRAIN_DELAY_MS=0
# SOLO pruebas de carga: multiplica todos los límites de rate limiting.
# Prohibido (el servidor no arranca) con NODE_ENV=production.
# RATE_LIMIT_SCALE=1

# --- Inteligencia artificial ---
# Consigue tu key en https://console.anthropic.com (API Keys)
ANTHROPIC_API_KEY=
# Consigue tu key en https://console.voyageai.com (usada para embeddings/RAG)
VOYAGE_API_KEY=

# --- Almacenamiento de documentos ---
# "local" en desarrollo (Fase 3). En Fase 6 se cambia a "s3".
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Proveedor de IA: "anthropic" (real, por defecto) o "mock".
# "mock" es SOLO para E2E y pruebas de carga: no llama a ninguna API, devuelve
# respuestas simuladas y el servidor se niega a arrancar con él si NODE_ENV=production.
AI_PROVIDER=anthropic
# Solo con AI_PROVIDER=mock: latencia artificial por llamada (ms) para pruebas de carga.
AI_MOCK_LATENCY_MS=0
