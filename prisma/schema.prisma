generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, vector]
}

model User {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String                @db.VarChar(150)
  email              String                @unique @db.VarChar(150)
  passwordHash       String                @map("password_hash") @db.VarChar(255)
  role               UserRole              @default(accountant)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  aiConversations    AiConversation[]
  auditEntries       AuditLog[]
  clients            Client[]
  portalClients      Client[]              @relation("ClientPortalUser")
  uploadedDocs       Document[]            @relation("UploadedBy")
  refreshTokens      RefreshToken[]
  /// Contadores a los que ayuda este usuario (si es assistant).
  assistsAccountants AccountantAssistant[] @relation("AssistantUser")
  /// Asistentes asignados a este usuario (si es accountant).
  assistants         AccountantAssistant[] @relation("AccountantUser")

  @@index([role], map: "idx_users_role")
  @@map("users")
}

model Client {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountantUserId String           @map("accountant_user_id") @db.Uuid
  fullName         String           @map("full_name") @db.VarChar(200)
  documentNumber   String           @map("document_number") @db.VarChar(30)
  email            String?          @db.VarChar(150)
  phone            String?          @db.VarChar(30)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  portalUserId     String?          @map("portal_user_id") @db.Uuid
  conversations    AiConversation[]
  alerts           Alert[]
  accountant       User             @relation(fields: [accountantUserId], references: [id], onUpdate: NoAction)
  portalUser       User?            @relation("ClientPortalUser", fields: [portalUserId], references: [id], onUpdate: NoAction)
  documents        Document[]
  taxConcepts      TaxConcept[]

  @@unique([accountantUserId, documentNumber])
  @@index([accountantUserId], map: "idx_clients_accountant")
  @@index([documentNumber], map: "idx_clients_document_number")
  @@index([accountantUserId, createdAt(sort: Desc)], map: "idx_clients_accountant_created")
  @@map("clients")
}

model Document {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String              @map("client_id") @db.Uuid
  uploadedBy   String              @map("uploaded_by") @db.Uuid
  docType      DocumentType        @map("doc_type")
  originalName String              @map("original_name") @db.VarChar(255)
  storageKey   String              @map("storage_key") @db.VarChar(500)
  status       DocumentStatus      @default(uploaded)
  errorMessage String?             @map("error_message")
  uploadedAt   DateTime            @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  processedAt  DateTime?           @map("processed_at") @db.Timestamptz(6)
  sha256       String?             @db.Char(64)
  alerts       Alert[]
  embeddings   DocumentEmbedding[]
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploader     User                @relation("UploadedBy", fields: [uploadedBy], references: [id], onUpdate: NoAction)
  taxConcepts  TaxConcept[]

  @@index([clientId], map: "idx_documents_client")
  @@index([status], map: "idx_documents_status")
  @@index([docType], map: "idx_documents_type")
  @@index([clientId, uploadedAt(sort: Desc)], map: "idx_documents_client_uploaded")
  @@index([uploadedBy], map: "idx_documents_uploaded_by")
  @@map("documents")
}

model TaxConcept {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId  String         @map("document_id") @db.Uuid
  clientId    String         @map("client_id") @db.Uuid
  conceptType TaxConceptType @map("concept_type")
  description String?        @db.VarChar(255)
  amount      Decimal        @db.Decimal(14, 2)
  periodYear  Int            @map("period_year") @db.SmallInt
  isAnomalous Boolean        @default(false) @map("is_anomalous")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  document    Document       @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([clientId, periodYear], map: "idx_tax_concepts_client_year")
  @@index([documentId], map: "idx_tax_concepts_document")
  @@index([conceptType], map: "idx_tax_concepts_type")
  @@map("tax_concepts")
}

model DocumentEmbedding {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String                @map("document_id") @db.Uuid
  chunkIndex Int                   @default(0) @map("chunk_index")
  chunkText  String                @map("chunk_text")
  embedding  Unsupported("vector")
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  document   Document              @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([documentId, chunkIndex], map: "uq_document_embeddings_document_chunk")
  @@index([documentId], map: "idx_document_embeddings_document")
  @@index([embedding], map: "idx_document_embeddings_vector")
  @@map("document_embeddings")
}

model Alert {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId   String        @map("client_id") @db.Uuid
  documentId String?       @map("document_id") @db.Uuid
  alertType  AlertType     @map("alert_type")
  severity   AlertSeverity @default(medium)
  message    String
  status     AlertStatus   @default(open)
  dueDate    DateTime?     @map("due_date") @db.Date
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime?     @map("resolved_at") @db.Timestamptz(6)
  dedupeKey  String?       @map("dedupe_key") @db.VarChar(100)
  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  document   Document?     @relation(fields: [documentId], references: [id], onUpdate: NoAction)

  @@index([clientId], map: "idx_alerts_client")
  @@index([dueDate], map: "idx_alerts_due_date")
  @@index([status], map: "idx_alerts_status")
  @@index([clientId, createdAt(sort: Desc)], map: "idx_alerts_client_created")
  @@index([documentId], map: "idx_alerts_document")
  @@index([clientId, dedupeKey], map: "idx_alerts_client_dedupe")
  @@map("alerts")
}

model AiConversation {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String      @map("client_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages  AiMessage[]

  @@index([clientId], map: "idx_ai_conversations_client")
  @@index([userId], map: "idx_ai_conversations_user")
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  role           AiMessageRole
  content        String
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversationId], map: "idx_ai_messages_conversation")
  @@map("ai_messages")
}

/// Historial de migraciones SQL. Lo gestionan los scripts de renta-ia-database
/// (migrate.sh / migrate.bat); la aplicación nunca escribe en esta tabla.
model SchemaMigration {
  filename  String   @id @db.VarChar(255)
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("schema_migrations")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model WebVital {
  id             BigInt   @id @default(autoincrement())
  metric         String   @db.VarChar(12)
  value          Float
  rating         String?  @db.VarChar(20)
  route          String   @db.VarChar(100)
  device         String   @db.VarChar(10)
  navigationType String?  @map("navigation_type") @db.VarChar(20)
  attribution    String?  @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_web_vitals_created")
  @@index([metric, route, createdAt(sort: Desc)], map: "idx_web_vitals_metric_route_created")
  @@map("web_vitals")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AccountantAssistant {
  assistantUserId  String   @map("assistant_user_id") @db.Uuid
  accountantUserId String   @map("accountant_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  accountant       User     @relation("AccountantUser", fields: [accountantUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assistant        User     @relation("AssistantUser", fields: [assistantUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([assistantUserId, accountantUserId])
  @@index([accountantUserId], map: "idx_accountant_assistants_accountant")
  @@map("accountant_assistants")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(50)
  entity    String?  @db.VarChar(30)
  entityId  String?  @map("entity_id") @db.VarChar(64)
  ip        String?  @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_audit_log_created")
  @@index([entity, entityId], map: "idx_audit_log_entity")
  @@index([userId, createdAt(sort: Desc)], map: "idx_audit_log_user_created")
  @@map("audit_log")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model LoginAttempt {
  keyHash     String    @id @map("key_hash") @db.Char(64)
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  lastFailure DateTime  @default(now()) @map("last_failure") @db.Timestamptz(6)

  @@map("login_attempts")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model RefreshToken {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  familyId     String         @map("family_id") @db.Uuid
  tokenHash    String         @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime       @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt    DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokeReason String?        @map("revoke_reason") @db.VarChar(30)
  replacedById String?        @map("replaced_by") @db.Uuid
  replacedBy   RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onUpdate: NoAction)
  replaces     RefreshToken[] @relation("RefreshTokenRotation")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_refresh_tokens_expires")
  @@index([familyId], map: "idx_refresh_tokens_family")
  @@index([userId], map: "idx_refresh_tokens_user")
  @@map("refresh_tokens")
}

enum UserRole {
  admin
  accountant
  assistant
  client

  @@map("user_role")
}

enum DocumentType {
  income_certificate
  bank_statement
  deductible_invoice
  exogenous_info
  pension_certificate
  other

  @@map("document_type")
}

enum DocumentStatus {
  uploaded
  processing
  processed
  error

  @@map("document_status")
}

enum TaxConceptType {
  gross_income
  withholding
  deduction
  pension_contribution
  health_contribution
  other

  @@map("tax_concept_type")
}

enum AlertType {
  deadline
  inconsistency

  @@map("alert_type")
}

enum AlertSeverity {
  low
  medium
  high
  critical

  @@map("alert_severity")
}

enum AlertStatus {
  open
  acknowledged
  resolved

  @@map("alert_status")
}

enum AiMessageRole {
  user
  assistant

  @@map("ai_message_role")
}
